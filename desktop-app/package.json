{
  "name": "monitoring-desktop",
  "version": "1.0.0",
  "description": "Electron desktop client for real-time monitoring",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.example.monitoringapp",
    "productName": "MonitoringApp",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "activity_monitor.exe",
        "to": "activity_monitor.exe"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "electron-squirrel-startup": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  }
}
