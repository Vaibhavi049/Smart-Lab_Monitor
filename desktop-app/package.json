{
  "name": "smartlab-assist",
  "version": "1.0.0",
  "description": "Lab assistance tool",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.smartlab.assist",
    "productName": "SmartLab_Assist",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      {
        "from": "activity_monitor.exe",
        "to": "activity_monitor.exe"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!public/**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "electron-squirrel-startup": "^1.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  }
}
