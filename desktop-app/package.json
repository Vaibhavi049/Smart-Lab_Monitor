{
  "name": "smartlab-assist",
  "version": "1.0.0",
  "description": "SmartLab Assist - Realtime Proctoring & Monitoring System",
  "author": "SmartLab Team",
  "copyright": "Copyright © 2026 SmartLab Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.smartlab.assist",
    "productName": "SmartLab_Assist",
    "directories": {
      "output": "SmartLab-Release"
    },
    "extraResources": [
      {
        "from": "activity_monitor.exe",
        "to": "activity_monitor.exe"
      },
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!public/**/*",
          "!.env"
        ]
      },
      {
        "from": "../backend/.env",
        "to": "backend/.env"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartLab Assist"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "electron-squirrel-startup": "^1.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^25.1.8"
  }
}